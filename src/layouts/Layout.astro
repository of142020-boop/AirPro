---
import '../styles/global.css';
import { launchReady } from '../../config/launch.mjs';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const indexable = launchReady && !!canonical && !noindex;
const nav = [['/', 'الرئيسية'], ['/services', 'الخدمات'], ['/blog', 'دليل التهوية'], ['/portfolio', 'أعمالنا'], ['/about', 'من نحن'], ['/contact', 'تواصل معنا']];
const active = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname === href || Astro.url.pathname.startsWith(href + '/');
const schema = canonical ? { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical, inLanguage: 'ar-EG' } : undefined;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="إير برو | AirPro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="إير برو، الصفحة الرئيسية">Air<span>Pro</span></a>
      <button type="button" class="menu-toggle" aria-controls="site-nav" aria-expanded="false">القائمة</button>
      <nav id="site-nav" class="site-nav" aria-label="التنقل الرئيسي">
        {nav.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="btn btn-primary header-book" href="/contact">احجز معاينة</a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="content footer-grid">
        <div><a class="brand" href="/">AirPro</a><p>خدمات تأسيس وتركيب الشفاطات وصيانة أنظمة التهوية. نوضح نطاق العمل والخامات المطلوبة قبل التنفيذ.</p></div>
        <div><h2>خدمات الشفاطات</h2><a href="/services/home-hood">تأسيس شفاط المطبخ</a><a href="/services/bathroom-fans">شفاطات الحمامات</a><a href="/services/restaurants-hood">هود ومداخن المطاعم</a><a href="/services/industrial-blowers">البلاورات والشفاطات الصناعية</a><a href="/services/exhaust-ducts">دكت الشفط والتهوية</a><a href="/services/maintenance">الصيانة والتنظيف</a></div>
        <div><h2>تواصل معنا</h2><a href="tel:+201101219418" dir="ltr">01101219418</a><a href="https://wa.me/201101219418">أرسل تفاصيل الطلب على واتساب</a><a href="/contact">الحجز والاستفسارات</a></div>
      </div>
      <div class="content footer-bottom"><p>© {new Date().getFullYear()} إير برو (AirPro)</p><a href="/privacy">الخصوصية</a><a href="/terms">شروط الخدمة</a></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
    </script>
  </body>
</html>
