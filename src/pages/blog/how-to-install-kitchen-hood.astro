---
import Layout from '../../layouts/Layout.astro';
import { getPageSeo } from '../../lib/seo';
import ArticleSchema from '../../components/ArticleSchema.astro';
const seo = getPageSeo('/blog/how-to-install-kitchen-hood');
---
<Layout title={seo.title} description={seo.description}>
<ArticleSchema path={seo.path} />
  <div class="hero"><div class="content"><p class="eyebrow">إير برو | AirPro</p><h1>{seo.h1}</h1><p>دليل لاختيار خطوات التجهيز المناسبة لجهازك، ثم مناقشتها مع فني التركيب.</p></div></div>
  <div class="content section">
<article class="prose"><nav class="toc" aria-label="محتويات الدليل"><a href="#model">نوع الجهاز</a><a href="#air">مسار الهواء</a><a href="#installation">التثبيت والفتحات</a><a href="#handover">فحص التسليم</a></nav>
<section id="model"><h2>تجهيز تركيب شفاط المطبخ: ابدأ برقم الموديل</h2><p>جهز صورة ملصق الجهاز والقطع المرفقة. المقاس التجاري لا يكفي لتحديد فتحة القص أو نقاط التعليق، وشكل الجهاز لا يحسم طريقة التهوية: الشفاط المسطح أو البلت إن أو الهرمي قد يدعم أوضاعاً مختلفة بحسب الموديل.</p><p>قارن مخطط التركيب بعرض الوحدة ومكان البوتاجاز وإمكانية فتح الفلاتر. إذا كانت الوحدة جاهزة، لا تقص الخشب قبل التأكد من أبعاد القص الفعلية.</p></section>
<section id="air"><h2>حدد هل ستطرد الهواء للخارج أم تعيد تدويره</h2><p>الطرد الخارجي يحتاج مساراً مناسباً ومخرجاً للخارج. إعادة التدوير تحتاج موديلًا يدعمها وفلاتر وملحقات مناسبة، وهي تعيد الهواء للغرفة ولا تطرد الرطوبة للخارج. لا يُفترض أن تركيب فلتر كربون يجعل كل جهاز صالحاً لهذا الوضع.</p><p>أرسل صورة المخرج الحالي ومسار الدكت المتوقع. تغيير قطر الماسورة أو كثرة الأكواع قد يؤثران على السحب والصوت، لذا تُراجع تعليمات الموديل بدلاً من اختيار مقاس موحد لكل المطابخ.</p></section>
<section id="installation"><h2>تأسيس فتحة شفاط المطبخ والتثبيت والكهرباء</h2><p>المسافة فوق سطح الطهي وطريقة التعليق ومقاس الدكت تُحدد من تعليمات الأجهزة. يُراجع حمل الجهاز ونقاط تثبيته؛ وفي الشفاطات السقفية لا يُفترض أن لوح الجبس وحده يتحمل الجهاز.</p><p>التوصيلات الكهربائية وفتح الخرسانة أو تجهيز الزجاج أعمال تُسند للمختص المناسب. راجع الخدمات المخفية وحالة العنصر الإنشائي قبل الفتح، ونوع الزجاج قبل طلب القص. وجود أجهزة احتراق في المكان يستلزم مراجعة تهوية المكان وهواء التعويض مع المختص.</p></section>
<section id="handover"><h2>ماذا تراجع عند التسليم؟</h2><ul><li>ثبات الجهاز وإمكانية فتح الفلاتر والوصول للصيانة.</li><li>تشغيل السرعات والإضاءة وغياب الاهتزاز غير الطبيعي.</li><li>مطابقة وضع التشغيل للطرد الخارجي أو إعادة التدوير.</li><li>وضوح طريقة تنظيف الفلاتر ومواعيد استبدالها بحسب الموديل.</li></ul><p>اتفق مسبقاً على تكلفة الجهاز والخامات والأجور وأي تعديل تشطيب. لا تُحكم جودة التركيب بعدد الوعود أو باسم الشكل وحده.</p></section>
<aside class="note"><p>دليل المصنع هو المرجع الخاص بجهازك. مثال للمراجعة: <a href="https://media3.bosch-home.com/Documents/9001482616_N.pdf">دليل تركيب وتشغيل شفاط سقفي من Bosch</a>؛ مواصفاته لا تُعمم على موديلات أخرى.</p></aside>
<section><h2>هل تحتاج تركيباً في مطبخك؟</h2><p>راجع <a href="/services/home-hood">خدمة تأسيس وتركيب شفاط المطبخ</a>، أو تفاصيل <a href="/services/built-in-hood">البلت إن</a> و<a href="/services/flat-hood">المسطح</a>، ثم <a href="/contact">أرسل موديل الجهاز وصور المكان</a>.</p></section><section><h2>تابع تجهيز طلبك</h2><ul>{seo.related.map(link => <li><a href={link.href}>{link.text}</a></li>)}</ul></section></article></div>
</Layout>
