---
import Layout from '../../layouts/Layout.astro';
import pages from '../../data/keyword-map.json';
const guides = pages.filter(page => page.path.startsWith('/blog/'));
---
<Layout title="دليل الشفاطات والبلاورات والدكت والتهوية | إير برو" description="أدلة اختيار الشفاط والبلاور، وتأسيس دكت المطابخ والحمامات وتهوية المطاعم، وفهم الصيانة وتنظيف الفلاتر قبل طلب الخدمة.">
<div class="hero"><div class="content"><p class="eyebrow">فهم الاختيار وتجهيز الطلب | إير برو</p><h1>دليل الشفاطات والبلاورات والدكت والتهوية</h1><p>ابدأ بالسؤال الذي يخص مكانك، ثم راجع الخدمة المرتبطة به. الأدلة تشرح المبادئ والتجهيزات، وتُراجع تفاصيل التنفيذ من تعليمات الجهاز ومتطلبات المشروع.</p></div></div>
<div class="content section"><div class="grid">{guides.map(guide => <article class="card"><p class="eyebrow">دليل تجهيز واختيار</p><h2><a href={guide.path}>{guide.h1}</a></h2><p>{guide.description}</p><a href={guide.path}>اقرأ الدليل</a></article>)}</div><aside class="note section"><h2>هل لديك صور وموديل أو مخطط؟</h2><p>راجع <a href="/services">خدمات التأسيس والتركيب والصيانة</a> لتحديد نطاق طلبك، ثم أرسل البيانات لمراجعة المعاينة.</p><a class="btn btn-primary" href="/contact">جهّز طلبك</a></aside></div>
</Layout>
