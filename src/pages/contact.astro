---
import Layout from '../layouts/Layout.astro';
---

<Layout title="اتصل بنا | إير برو - شركة تركيب شفاطات مطاعم وتأسيس الفلل" description="تواصل مع إير برو لطلب فني تركيب شفاط مطبخ، معاينة مجانية لتركيب مداخن المطاعم، واستخراج شهادة دفاع مدني. نصلك أينما كنت في مصر.">
	<section style="padding: 150px 20px 80px; background: linear-gradient(135deg, var(--background) 0%, rgba(14, 165, 233, 0.05) 100%); text-align: center;">
		<div class="animate-fade-up">
			<span style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 2px;">نحن هنا لخدمتك</span>
			<h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: var(--primary-dark); margin: 15px 0;">
				تواصل معنا
			</h1>
			<p style="color: var(--text-muted); font-size: 1.2rem; max-width: 1200px; margin: 0 auto;">
				فريق إير برو جاهز للرد على استفساراتك، تقديم الاستشارات الهندسية، وعمل المعاينات في أسرع وقت.
			</p>
		</div>
	</section>

	<section class="section" style="padding-top: 40px; padding-bottom: 80px;">
		<div style="display: flex; flex-wrap: wrap; gap: 40px;">
			
			<!-- Contact Information -->
			<div class="reveal" style="flex: 1; min-width: 300px; display: flex; flex-direction: column; gap: 20px;">
				<h2 style="font-size: 2rem; color: var(--primary-dark); margin-bottom: 20px;">بيانات التواصل المباشر</h2>
				
				<div class="glass-card" style="display: flex; align-items: center; gap: 20px;">
					<div style="width: 50px; height: 50px; background: rgba(14, 165, 233, 0.1); color: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
						📞
					</div>
					<div>
						<h4 style="color: var(--text); font-size: 1.1rem; margin-bottom: 5px;">رقم الهاتف (الخط الساخن)</h4>
						<a href="tel:19418" style="color: var(--primary); text-decoration: none; font-weight: 700; font-size: 1.2rem; direction: ltr; display: inline-block;">19418</a>
					</div>
				</div>

				<div class="glass-card" style="display: flex; align-items: center; gap: 20px;">
					<div style="width: 50px; height: 50px; background: rgba(37, 211, 102, 0.1); color: #25D366; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
						<svg width="1em" height="1em" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6z"></path></svg>
					</div>
					<div>
						<h4 style="color: var(--text); font-size: 1.1rem; margin-bottom: 5px;">واتساب (للمقايسات السريعة)</h4>
						<a href="https://wa.me/201101219418" style="color: var(--text-muted); text-decoration: none; font-size: 1.1rem; direction: ltr; display: inline-block;">+20 110 121 9418</a>
					</div>
				</div>

				<div class="glass-card" style="display: flex; align-items: center; gap: 20px;">
					<div style="width: 50px; height: 50px; background: rgba(14, 165, 233, 0.1); color: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
						📧
					</div>
					<div>
						<h4 style="color: var(--text); font-size: 1.1rem; margin-bottom: 5px;">البريد الإلكتروني</h4>
						<a href="mailto:info@airproeg.com" style="color: var(--text-muted); text-decoration: none; font-size: 1.1rem;">info@airproeg.com</a>
					</div>
				</div>

				<div class="glass-card" style="display: flex; align-items: center; gap: 20px;">
					<div style="width: 50px; height: 50px; background: rgba(14, 165, 233, 0.1); color: var(--primary); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
						🕒
					</div>
					<div>
						<h4 style="color: var(--text); font-size: 1.1rem; margin-bottom: 5px;">مواعيد العمل</h4>
						<p style="color: var(--text-muted); font-size: 1.1rem;">يومياً من 9 صباحاً حتى 9 مساءً<br><span style="font-size: 0.9rem; color: var(--primary);">* طوارئ الصيانة 24 ساعة للعملاء</span></p>
					</div>
				</div>
			</div>

			<!-- Contact Form -->
			<div class="reveal reveal-delay-2" style="flex: 1.5; min-width: 300px; background: var(--card-bg); padding: 40px; border-radius: 20px; border: 1px solid var(--glass-border); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);">
				<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 10px;">أرسل لنا طلبك</h2>
				<p style="color: var(--text-muted); margin-bottom: 30px;">قم بتعبئة النموذج التالي وسيقوم أحد مهندسينا بالتواصل معك فوراً.</p>
				
				<form onsubmit="event.preventDefault(); alert('تم إرسال رسالتك بنجاح! سنتواصل معك قريباً.');" style="display: flex; flex-direction: column; gap: 20px;">
					<div>
						<label style="display: block; margin-bottom: 8px; color: var(--text); font-weight: 600;">الاسم الكريم</label>
						<input type="text" required placeholder="مثال: أحمد محمود" style="width: 100%; padding: 15px; border-radius: 10px; border: 1px solid rgba(0, 0, 0, 0.2); font-family: inherit; font-size: 1rem; background: var(--card-bg);">
					</div>
					<div style="display: flex; gap: 20px; flex-wrap: wrap;">
						<div style="flex: 1; min-width: 200px;">
							<label style="display: block; margin-bottom: 8px; color: var(--text); font-weight: 600;">رقم الموبايل</label>
							<input type="tel" required placeholder="01X XXXX XXXX" style="width: 100%; padding: 15px; border-radius: 10px; border: 1px solid rgba(0, 0, 0, 0.2); font-family: inherit; font-size: 1rem; background: var(--card-bg);">
						</div>
						<div style="flex: 1; min-width: 200px;">
							<label style="display: block; margin-bottom: 8px; color: var(--text); font-weight: 600;">نوع الخدمة المطلوبة</label>
							<select style="width: 100%; padding: 15px; border-radius: 10px; border: 1px solid rgba(0, 0, 0, 0.2); font-family: inherit; font-size: 1rem; background: var(--card-bg);">
								<option>تأسيس مدخنة فيلا/شقة</option>
								<option>هود مطاعم (ستانلس / دكت)</option>
								<option>تهوية صناعية لمصنع</option>
								<option>صيانة وتنظيف مداخن</option>
								<option>أخرى</option>
							</select>
						</div>
					</div>
					<div>
						<label style="display: block; margin-bottom: 8px; color: var(--text); font-weight: 600;">تفاصيل الطلب (اختياري)</label>
						<textarea rows="4" placeholder="اكتب أي تفاصيل إضافية عن موقعك أو المشكلة التي تواجهها..." style="width: 100%; padding: 15px; border-radius: 10px; border: 1px solid rgba(0, 0, 0, 0.2); font-family: inherit; font-size: 1rem; background: var(--card-bg); resize: vertical;"></textarea>
					</div>
					<button type="submit" class="btn btn-primary" style="width: 100%; padding: 15px; font-size: 1.2rem; border: none; cursor: pointer;">
						إرسال الطلب الآن
					</button>
				</form>
			</div>

		</div>
	</section>
</Layout>
