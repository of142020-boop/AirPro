---
import Layout from '../layouts/Layout.astro';
---

<Layout title="تركيب شفاط مطبخ وتصنيع هود مداخن مطاعم | إير برو مصر" description="إير برو هي أفضل شركة تركيب شفاط مطبخ وشفاط مدخنه في مصر. نوفر فني تركيب شفاط المطبخ، شفاطات مركزيه، وتركيب مدخنة شفاط مطبخ بأعلى جودة.">
	<!-- Hero Section -->
	<div style="min-height: 80vh; display: flex; align-items: center; background: var(--secondary); position: relative; padding-top: 80px; padding-bottom: 60px;">
		<div class="section" style="position: relative; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; gap: 40px; width: 100%;">
			<div class="animate-fade-up" style="flex: 1; min-width: 300px; padding-right: 5%;">
				<span style="display: inline-block; padding: 8px 15px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 20px; font-weight: 700; margin-bottom: 20px;">الشركة الأولى المعتمدة في مصر</span>
				<h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; line-height: 1.3; margin-bottom: 20px; color: #ffffff;">
					أسرع وأفضل خبراء <br/><span style="color: var(--primary);">أنظمة التهوية في مصر!</span>
				</h1>
				<p style="color: rgba(255,255,255,0.8); font-size: 1.2rem; margin-bottom: 30px; line-height: 1.8;">
					من ترشيح افضل شفاط مطبخ قوي، وتوفير أمهر فني تركيب شفاط المطبخ (سواء شفاط مركزي، توشيبا، أو حمام)، وصولاً إلى صيانة مداخن المطاعم بأعلى معايير الجودة.
				</p>
				<div style="display: flex; gap: 15px; flex-wrap: wrap;">
					<a href="/contact" class="btn btn-primary" style="padding: 15px 40px; font-size: 1.2rem; border-radius: 8px;">طلب خدمة</a>
				</div>
			</div>
			<div class="animate-fade-up" style="flex: 1; min-width: 300px; display: flex; justify-content: center;">
				<div style="width: 100%; max-width: 550px; height: 450px; background: url('/hero_exhaust_fans_1790261166785.jpg') center/cover; border-radius: 12px; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);"></div>
			</div>
		</div>
	</div>

	<!-- Features Bar -->
	<div style="margin: -60px 20px 60px; position: relative; z-index: 10;">
		<div class="section" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
			<div class="glass-card reveal reveal-delay-1" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 15px; padding: 30px;">
				<div style="font-size: 3rem; color: var(--primary);"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"></path></svg></div>
				<div><span style="display: block; font-size: 1.4rem; font-weight: 700; color: var(--text);">ضمان معتمد</span><span style="color: var(--text-muted); font-size: 1rem; display: block; margin-top: 10px;">شهادات ومطابقة الدفاع المدني</span></div>
			</div>
			<div class="glass-card reveal reveal-delay-2" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 15px; padding: 30px;">
				<div style="font-size: 3rem; color: var(--primary);"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"></path></svg></div>
				<div><span style="display: block; font-size: 1.4rem; font-weight: 700; color: var(--text);">فنيين خبراء</span><span style="color: var(--text-muted); font-size: 1rem; display: block; margin-top: 10px;">دقة هندسية وتخريم بالكور بدون تكسير</span></div>
			</div>
			<div class="glass-card reveal reveal-delay-3" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 15px; padding: 30px;">
				<div style="font-size: 3rem; color: var(--primary);"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2v11h3v9l7-12h-4l4-8z"></path></svg></div>
				<div><span style="display: block; font-size: 1.4rem; font-weight: 700; color: var(--text);">خدمة سريعة</span><span style="color: var(--text-muted); font-size: 1rem; display: block; margin-top: 10px;">علاج ضعف السحب والطوارئ فوراً</span></div>
			</div>
		</div>
	</div>

	<!-- Main Services Core -->
	<section class="section" style="padding-top: 60px; padding-bottom: 60px;">
		<div style="text-align: center; margin-bottom: 50px;" class="reveal">
			<span style="color: var(--secondary); font-weight: 600;">خدماتنا التخصصية</span>
			<h2 style="font-size: 2.5rem; color: var(--primary-dark);">نغطي كافة قطاعات التهوية والشفط</h2>
		</div>
		
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px;">
			
			<!-- Service 1: Home & Villas -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-house"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">القطاع السكني (الشقق والفلل)</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب شفاط مطبخ مخفي، تأسيس دكت قبل السيراميك، عمل فتحات بالكور بدون تكسير، وتأسيس الشفاطات المركزية للقصور.
					</p>
				</div>
				<a href="/services/home-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 2: Commercial & Restaurants -->
			<div class="glass-card reveal reveal-delay-2" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-industry"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">القطاع التجاري (المطاعم والمصانع)</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تصنيع هود ستانلس ستيل، تركيب دكت التكييف، فريش اير، بلاورات سحب عملاقة، ومطابقة اشتراطات الدفاع المدني بالكامل.
					</p>
				</div>
				<a href="/services/restaurants-hood" class="btn btn-primary" style="padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 3: Maintenance & Cleaning -->
			<div class="glass-card reveal reveal-delay-3" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-wrench"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">الصيانة والدعم الفني</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						غسيل مداخن المطاعم كيميائياً، استخراج شهادات نظافة معتمدة، صيانة مواتير الشفاطات وتغيير السيور، ومعالجة ضعف السحب.
					</p>
				</div>
				<a href="/services/maintenance" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 4: Built-in Hoods -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-fire-burner"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط بلت ان</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تأسيس وتركيب شفاطات البلت ان المخفية بأعلى كفاءة، مع الحفاظ على الديكور الداخلي وتجنب ارتداد الروائح.
					</p>
				</div>
				<a href="/services/built-in-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 5: Bathroom Fans -->
			<div class="glass-card reveal reveal-delay-2" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-shower"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">شفاطات حمامات</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب شفاطات الحمامات المركزية والسقفية بدقة لسحب الأبخرة والرطوبة بدون أي إزعاج وصوت صامت تماماً.
					</p>
				</div>
				<a href="/services/bathroom-fans" class="btn btn-primary" style="padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 6: Toshiba Fans -->
			<div class="glass-card reveal reveal-delay-3" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-regular fa-star"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط توشيبا</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						فنيون متخصصون لتركيب وصيانة شفاطات توشيبا بجميع أحجامها، مع قص الزجاج الاحترافي والتأسيس الكهربائي السليم.
					</p>
				</div>
				<a href="/services/toshiba-hoods" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 7: Flat Hood -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-regular fa-square"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط مسطح</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تأسيس وتركيب شفاطات مسطحة (بلت ان وبدون مدخنة) لمطابخ عصرية وأنيقة.
					</p>
				</div>
				<a href="/services/flat-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 8: Pyramid Hood -->
			<div class="glass-card reveal reveal-delay-2" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-caret-up"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط هرمي</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب المداخن الهرمية الكلاسيكية بجميع مقاساتها، مع تمديد مواسير التهوية بشكل احترافي.
					</p>
				</div>
				<a href="/services/pyramid-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 9: Central Exhaust -->
			<div class="glass-card reveal reveal-delay-3" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-regular fa-building"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">أنظمة شفاط مركزي</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تصميم وتنفيذ تهوية مركزية للفلل الكبرى والمطاعم لضمان سحب الروائح بدون أصوات مزعجة.
					</p>
				</div>
				<a href="/services/central-exhaust" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 10: Industrial Blowers -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-fan"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">بلاورات وشفاطات صناعية</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب بلاور شفط وطرد ضخم لتلبية احتياجات المصانع والمطاعم الكبرى، ومراوح طرد مركزي تتحمل ضغط العمل العالي.
					</p>
				</div>
				<a href="/services/industrial-blowers" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>
			
			<!-- Service 11: AC Ducts -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between;">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-wind"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">دكت التكييف المركزي</h2>
					<p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6; margin-bottom: 25px;">
						تصنيع وتركيب دكت التكييف المركزي والمخفي للفلل والمستشفيات بأفضل صاج مجلفن ومعزول مطابق للمواصفات.
					</p>
				</div>
				<a href="/services/ac-ducts" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

		</div>
	</section>

	<!-- Massive Authority SEO Block (The Ultimate Guide) -->
	<section style="background: rgba(14, 165, 233, 0.03); padding: 80px 20px; margin: 40px 0;">
		<div class="section reveal">
			<div style="max-width: 900px; margin: 0 auto; background: var(--card-bg); padding: 50px; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05);">
				<h2 style="font-size: 2.2rem; color: var(--primary-dark); margin-bottom: 20px; text-align: center;">لماذا تعتبر إير برو الخيار الأقوى في مصر؟</h2>
				
					في عالم التهوية الحديثة، لا مجال للخطأ العشوائي. يتساءل الكثيرون عن اسعار مداخن المطاعم أو سعر متر الصاج المجلفن، ولكن القيمة الحقيقية تكمن في الهندسة السليمة. بصفتنا أكبر شركة تركيب شفاطات مطاعم معتمدة، نؤمن أن الشفاط ليس مجرد مروحة، بل هو نظام متكامل يضمن سلامة المنشأة.

				<h3 style="font-size: 1.5rem; color: var(--primary); margin-top: 30px; margin-bottom: 15px;">احترافية التنفيذ للمنازل والفلل</h3>
					الكثير من العملاء يبحثون عن تركيب شفاط المطبخ على الشباك، تركيب شفاط مطبخ بدون مدخنة، أو حتى تأسيس شفاط المطبخ قبل السيراميك. السر لدينا يكمن في توفير فني تركيب شفاطات محترف ومعدات حديثة مثل الكور لعمل الفتحات بدون تكسير الديكور، بالإضافة لتوفير صنايعي تركيب شفاط مطبخ بلت ان على أعلى مستوى من الدقة.

				<h3 style="font-size: 1.5rem; color: var(--primary); margin-top: 30px; margin-bottom: 15px;">حلول جذرية لمشاكل المطاعم والمصانع</h3>
					هل تعاني من ارتداد الدخان؟ نقدم علاجاً جذرياً لضعف سحب شفاط المطبخ عبر فني صيانة شفاطات خبير يقوم بصيانة مواتير الشفاطات وتغيير السيور. كما نصنع هود ستانلس ستيل عبر معلم تركيب مداخن متخصص، ونوفر عقود صيانة سنوية تتضمن غسيل مداخن المطاعم بالمواد الكيميائية مع استخراج شهادات الدفاع المدني.
			</div>
		</div>
			</div>
		</div>
	</section>

	<!-- Brands & General Keywords Expansion -->
	<section class="section" style="padding-top: 40px; padding-bottom: 40px;">
		<div style="text-align: center; margin-bottom: 50px;" class="reveal">
			<span style="color: var(--secondary); font-weight: 600;">الأنواع والماركات</span>
			<h2 style="font-size: 2.5rem; color: var(--primary-dark);">نتعامل مع أفضل شفاطات المطابخ العالمية والمحلية</h2>
		</div>
		<div class="reveal" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
			<div class="glass-card" style="padding: 30px; text-align: center; ">
				<h4 style="color: var(--primary); font-size: 1.3rem; margin-bottom: 10px;">شفاطات توشيبا وفريش</h4>
				<p style="color: var(--text-muted); font-size: 0.95rem;">نمتلك خبرة طويلة في تركيب وتأسيس فتحات شفاط توشيبا (الزجاجي والعادي) بمختلف مقاساته، بالإضافة لخدمات تأسيس شفاط فريش الشهير لضمان عدم اهتزاز الحائط.</p>
			</div>
			<div class="glass-card" style="padding: 30px; text-align: center; ">
				<h4 style="color: var(--primary); font-size: 1.3rem; margin-bottom: 10px;">الشفاط البلت ان والمخفي</h4>
				<p style="color: var(--text-muted); font-size: 0.95rem;">يبحث الكثيرون عن شفاط مطبخ بلت ان لإخفائه داخل الديكور. نوفر حلول تمديد الدكت وتأسيس افضل شفاط مطبخ بلت ان تركي أو إيطالي بكفاءة تامة.</p>
			</div>
			<div class="glass-card" style="padding: 30px; text-align: center; ">
				<h4 style="color: var(--primary); font-size: 1.3rem; margin-bottom: 10px;">الشفاط المسطح والهرمي</h4>
				<p style="color: var(--text-muted); font-size: 0.95rem;">سواء كان اختيارك هو شفاط مطبخ مسطح (بدون مدخنة) أو شفاط هرمي كلاسيكي، المهندسون لدينا يضمنون لك تركيباً مثالياً يمنع تسرب أي روائح للمنزل.</p>
			</div>
		</div>
	</section>

	<!-- FAQs - Highly targeted to long-tail keywords -->
	<section class="section" style="padding-top: 40px; padding-bottom: 80px;">
		<div style="text-align: center; margin-bottom: 40px;" class="reveal">
			<h2 style="font-size: 2.5rem; color: var(--primary-dark);">الأسئلة الشائعة (دليل العملاء)</h2>
			<p style="color: var(--text-muted);">إجابات هندسية على أكثر الاستفسارات شيوعاً في السوق المصري</p>
		</div>

		<div class="reveal" style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 15px;">
			
			<div class="faq-item">
				<button class="faq-question">
					ما هي طريقة تركيب شفاط المطبخ المخفي (بلت ان) بشكل صحيح؟
					<span class="faq-icon">▼</span>
				</button>
				<div class="faq-answer">
					أفضل طريقة هي التأسيس المبكر قبل السيراميك. نقوم بعمل فتحة دقيقة بالكور، ثم تمديد دكت صاج أو مواسير مرنة معزولة داخل الجبس بورد، وتوصيلها بخارج الفيلا، مما يضمن قوة سحب جبارة مع شكل ديكوري مخفي تماماً داخل الكابينة.
				</div>
			</div>

			<div class="faq-item">
				<button class="faq-question">
					هل يمكن علاج ضعف سحب الشفاط أو تصليح موتور شفاط المطبخ الهرمي؟
					<span class="faq-icon">▼</span>
				</button>
				<div class="faq-answer">
					بالتأكيد. ضعف السحب غالباً ينتج عن تراكم الزيوت، انسداد الدكت، أو تلف في محامل البلاور والموتور. فريقنا يقوم بصيانة كاملة للموتور، تنظيف الفلاتر الكربونية أو الألومنيوم، وإعادة الشفاط لقوته الأصلية بدلاً من تغييره بالكامل.
				</div>
			</div>

			<div class="faq-item">
				<button class="faq-question">
					ما هي متطلبات استخراج شهادة نظافة مدخنة للدفاع المدني للمطاعم؟
					<span class="faq-icon">▼</span>
				</button>
				<div class="faq-answer">
					يشترط الدفاع المدني خلو الهود، الدكت، ومروحة السحب من الشحوم تماماً لتفادي الحرائق. بصفتنا شركة معتمدة، نقوم بغسيل كيميائي عميق وإزالة الزيوت المستعصية، ثم نصدر لك الشهادة المعتمدة لتقديمها للجهات المختصة.
				</div>
			</div>

			<div class="faq-item">
				<button class="faq-question">
					كيف يتم تسعير مداخن المطاعم وهود الستانلس ستيل؟
					<span class="faq-icon">▼</span>
				</button>
				<div class="faq-answer">
					تختلف أسعار مداخن المطاعم وسعر متر الصاج المجلفن بناءً على: مقاس الهود، طول مسار الدكت، قوة البلاور المطلوب (حصان)، ونوع الفلاتر (مائية أو كربونية). نوفر مقايسات هندسية دقيقة لتسعير مشروعك بأفضل تكلفة في السوق.
				</div>
			</div>

		</div>
	</section>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const faqs = document.querySelectorAll('.faq-question');
			faqs.forEach(faq => {
				faq.addEventListener('click', () => {
					const parentItem = faq.parentElement;
					
					// Close all other FAQs
					faqs.forEach(otherFaq => {
						if (otherFaq !== faq) {
							otherFaq.parentElement.classList.remove('active');
						}
					});

					// Toggle current FAQ
					parentItem.classList.toggle('active');
				});
			});
		});
	</script>
</Layout>
