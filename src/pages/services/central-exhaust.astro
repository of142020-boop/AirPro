---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="تأسيس شفاط مركزي وتهوية مركزية | أنظمة سحب قوية" description="إير برو هي الشركة الرائدة في توريد وتركيب شفاط مركزي للمنازل والمطاعم الكبرى. نقدم أنظمة تهوية مركزية متكاملة شاملة تمديد الدكت وتركيب مراوح السحب.">
	<section style="padding: 150px 20px 80px; background: linear-gradient(135deg, var(--background) 0%, rgba(14, 165, 233, 0.05) 100%); text-align: center;">
		<div class="animate-fade-up">
			<span style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 2px;">أقوى أنظمة السحب للقصور والمطاعم</span>
			<h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: var(--primary-dark); margin: 15px 0;">
				أنظمة <span class="gradient-text">شفاط مركزي</span> وتهوية مركزية
			</h1>
			<p style="color: var(--text-muted); font-size: 1.2rem; max-width: 700px; margin: 0 auto;">
				نصمم وننفذ أقوى أنظمة الـ شفاط مركزي لسحب الهواء والدخان من عدة نقاط وتوجيهها إلى مروحة طرد رئيسية خارجية، مما يوفر هدوءاً داخلياً تاماً وقوة شفط لا مثيل لها.
			</p>
		</div>
	</section>

	<!-- SEO Optimized Placeholder Image -->
	<div class="section reveal" style="margin-top: -30px; margin-bottom: 50px; padding: 0 20px;">
		<div style="max-width: 900px; margin: 0 auto; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.1); border: 1px solid var(--glass-border); position: relative; background: #e2e8f0; display: flex; align-items: center; justify-content: center; min-height: 400px;">
			<!-- This is the placeholder img tag -->
			<img src="/images/services/andhemat-tahweya-w-shafat-markazy.jpg" alt="تصميم وتركيب أنظمة شفاط مركزي للفلل والمطاعم" title="تصميم وتركيب أنظمة شفاط مركزي للفلل والمطاعم" style="width: 100%; max-height: 450px; object-fit: cover; display: block;" />
			<div style="position: absolute; color: #64748b; font-size: 1.2rem; font-weight: 700;">صورة: تصميم وتركيب أنظمة شفاط مركزي للفلل والمطاعم</div>
		</div>
	</div>


	<section class="section" style="padding-top: 40px; padding-bottom: 80px;">
		<div class="reveal">
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
				<div class="glass-card" style="border-top: 4px solid var(--secondary);">
					<h3 style="font-size: 1.5rem; color: var(--primary); margin-bottom: 15px;">تركيب شفاطات مركزية للمطابخ الكبيرة</h3>
					<p style="color: var(--text-muted); line-height: 1.8;">
						للقصور والفلل الفخمة، يعتبر نظام الـ شفاط مطبخ مركزي هو الحل الأفضل. يتم تمديد المواسير وتركيب مراوح الشفط المركزية على السطح. ولتسهيل قرارك، نوفر لك تقديراً مبدئياً لـ سعر الشفاط المركزي.
					</p>
				</div>
				<div class="glass-card" style="border-top: 4px solid var(--primary);">
					<h3 style="font-size: 1.5rem; color: var(--primary); margin-bottom: 15px;">تهوية المطاعم والمشاريع التجارية</h3>
					<p style="color: var(--text-muted); line-height: 1.8;">
						نقوم بتصميم نظام دكت تكييف مركزي متكامل يشمل شفاط مركزي للمطبخ مع ضخ الهواء النقي (Fresh Air) لضمان بيئة عمل صحية وتوافق مع اشتراطات الأمن والسلامة.
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
