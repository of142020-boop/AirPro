---
import Layout from '../../layouts/Layout.astro';
import seo from '../../data/home-hood-seo.json';
import { getPageSeo } from '../../lib/seo';
const pageSeo = getPageSeo('/services/home-hood');
const pageUrl = Astro.site ? new URL('/services/home-hood', Astro.site).href : undefined;
const businessId = Astro.site ? new URL('/#business', Astro.site).href : undefined;
const schema = pageUrl ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'LocalBusiness', '@id': businessId, name: 'إير برو | AirPro', url: Astro.site!.href, telephone: '+201101219418' },
    { '@type': 'Service', '@id': `${pageUrl}#service`, name: 'تركيب شفاط مطبخ وتأسيس الدكت', serviceType: 'تأسيس وتركيب شفاط المطبخ', url: pageUrl, description: seo.description, provider: { '@id': businessId }, mainEntityOfPage: pageUrl },
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, url: pageUrl, mainEntity: seo.faq.map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }
  ]
} : undefined;
---
<Layout title={pageSeo.title} description={pageSeo.description}>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />}
  <div class="hero"><div class="content">
    <nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>›</span><a href="/services">الخدمات</a><span>›</span><span>شفاط المطبخ</span></nav>
    <p class="eyebrow">إير برو | تأسيس وتركيب الشفاطات</p>
    <h1>تركيب شفاط مطبخ وتأسيس الدكت قبل التشطيب</h1>
    <p>الموتور القوي وحده لا يكفي إذا كان مسار الهواء ضيقاً أو مليئاً بالأكواع. نراجع موديل الشفاط ومكانه وفتحة الطرد قبل التنفيذ، لتحديد تركيب يناسب مطبخك ويسهّل صيانته.</p>
    <div class="actions"><a class="btn btn-primary" href="/contact">أرسل صور المطبخ واطلب عرض سعر</a><a class="btn btn-secondary" href="tel:+201101219418">اتصل: 01101219418</a></div>
    <p>أرسل منطقتك لتأكيد توافر الخدمة وتكلفة الانتقال وموعد المعاينة.</p>
  </div></div>
  <article class="content prose section">
    <nav class="toc" aria-label="محتويات الصفحة"><a href="#foundation">خطوات التأسيس</a><a href="#sizes">المقاسات والخامات</a><a href="#problems">ضعف السحب والضوضاء</a><a href="#safety">الأمان</a><a href="#cost">التكلفة</a><a href="#questions">الأسئلة الشائعة</a></nav>
    <section aria-labelledby="answer-title"><h2 id="answer-title">ما الذي يشمله تأسيس شفاط المطبخ؟</h2>
      <p>تأسيس شفاط المطبخ هو تجهيز موضع التثبيت ومسار الدكت وفتحة الطرد ونقطة الكهرباء بما يطابق دليل الجهاز. أما التركيب فيشمل تثبيت الشفاط وتوصيل المسار ومراجعة التشغيل. يفضّل تنسيق التأسيس قبل إغلاق الجبس وتركيب الدواليب، مع تحديد الأعمال والخامات التي يشملها العرض.</p>
      <p>هذه الخدمة تناسب أصحاب الشقق والفلل أثناء التشطيب، وكذلك المطابخ القائمة التي تحتاج مراجعة مسار الشفط. ولمهندس الديكور أو النجّار، أهم نقطة هي اعتماد مخطط الجهاز قبل قص وحدة المطبخ.</p>
    </section>
    <section id="foundation"><h2>خطوات تأسيس دكت شفاط المطبخ وتركيبه</h2>
      <h3>1. مراجعة موديل الجهاز ومخطط المطبخ</h3>
      <p>نبدأ برقم الموديل، ومكان سطح الطهي، وعرض الجهاز، ومخطط القص والتعليق. عرض الشفاط التجاري لا يساوي بالضرورة فتحة تركيبه، خصوصاً في <a href="/services/built-in-hood">تركيب شفاط بلت إن داخل وحدات المطبخ</a>. تُراجع أيضاً مساحة الوصول إلى الفلاتر والكهرباء لاحقاً.</p>
      <h3>2. اختيار مسار الهواء وموضع الطرد</h3>
      <p>يُختار مسار مباشر وقصير قدر الإمكان، مع تقليل الانحناءات والانتقالات المفاجئة والتحقق من سماح المبنى بموضع الخروج. يُراجع هواء التعويض حتى يجد الهواء المسحوب بديلاً مناسباً، وتُدرس بوابة منع الرجوع عند الحاجة دون إعاقة الطرد.</p>
      <h3>3. تنسيق الفتحة والكهرباء قبل إغلاق التشطيبات</h3>
      <p>تحدد أبعاد الفتحة بعد معرفة المقاس الخارجي للدكت ووسيلة مروره وإحكامه؛ مقاس فتحة الكور دريل ليس تلقائياً قطر الدكت نفسه. يراجع المختص الخدمات المخفية والعناصر الإنشائية قبل الثقب، ويجهز الكهربائي نقطة التغذية وفق تعليمات الجهاز.</p>
      <h3>4. تثبيت الشفاط وإحكام الوصلات</h3>
      <p>نراجع ملاءمة الحائط أو الوحدة للحمل ونقاط التعليق، ونثبت المسار دون سحق الخرطوم أو تحميل وزن الدكت على مخرج الجهاز. تُحكم الوصلات بمواد مناسبة للنظام، وتبقى الفلاتر والأجزاء التي تحتاج صيانة قابلة للوصول.</p>
      <h3>5. مراجعة التشغيل وتسليم نطاق العمل</h3>
      <ul><li>مراجعة اتجاه خروج الهواء وحركة بوابة الطرد.</li><li>تشغيل السرعات وملاحظة الاهتزاز والضوضاء وتسريب الوصلات.</li><li>شرح فك الفلاتر والعناية بها وفق دليل الموديل.</li><li>تحديد أي قياسات تدفق مطلوبة وأدواتها ضمن العرض؛ ملاحظة السحب وحدها ليست قياساً هندسياً.</li></ul>
    </section>
    <section id="sizes"><h2>مقاسات مواسير شفاط المطبخ والخامات المناسبة</h2>
      <h3>كيف نختار قطر الدكت وقوة الشفط؟</h3>
      <p>المرجع الأول هو دليل الموديل وقطر مخرجه، ثم طول المسار وعدد الأكواع ومقاومة الشبكة. معدل التدفق بوحدة م³/ساعة (m³/h) يختلف عن الضغط بوحدة باسكال (Pa)، والأداء المعلن للجهاز لا يساوي بالضرورة التدفق بعد توصيله بدكت طويل.</p>
      <div class="table-wrap" role="region" aria-label="مقارنة أقطار دكت الشفاط" tabindex="0"><table><caption>أمثلة للمقارنة؛ الاختيار النهائي حسب الموديل والمسار</caption><thead><tr><th scope="col">القطر</th><th scope="col">متى يُراجع؟</th><th scope="col">ما الذي نتجنبه؟</th></tr></thead><tbody>
        <tr><th scope="row">100 مم</th><td>إذا نص دليل الجهاز صراحةً على ملاءمته.</td><td>تحويل مخرج أكبر إليه لمجرد وجود فتحة قديمة.</td></tr>
        <tr><th scope="row">120–125 مم</th><td>في الموديلات التي تسمح بهذا المقاس وبملحقات متوافقة.</td><td>افتراض أن 120 و125 مم وصلة واحدة دون التحقق.</td></tr>
        <tr><th scope="row">150 مم</th><td>في الأجهزة التي توصي بهذا المخرج؛ ليس مقاساً إلزامياً لكل جهاز.</td><td>تصغيره دون مراجعة أثر المقاومة وتعليمات المصنع.</td></tr>
      </tbody></table></div>
      <h3>دكت معدني أم PVC أم خرطوم مرن؟</h3>
      <p>تُحدد الخامة طبقاً لتعليمات الشفاط وطبيعة الهواء ومتطلبات المشروع. الصاج المجلفن أو غيره من الدكت المعدني ليس اختياراً يُحسم بالاسم وحده؛ تهم نعومة المسار والإحكام والتثبيت. لا نفترض صلاحية مواسير PVC للعادم الساخن أو المحمل بالدهون؛ بعض الأجهزة تشترط مجرى غير قابل للاحتراق. وإذا سمح المصنع بوصلات مرنة، تُراجع طريقة تمديدها لتفادي الضغط والانثناءات الحادة.</p>
      <h3>شفاط بمدخنة أم فلتر كربون؟</h3>
      <ul><li><strong>الطرد الخارجي:</strong> ينقل الهواء وبخار الطبخ إلى خارج المكان عبر مخرج مناسب.</li><li><strong>إعادة التدوير:</strong> تعتمد على موديل يدعم هذا الوضع وطقم فلاتر متوافق؛ تساعد في تقليل الروائح ولا تطرد الرطوبة إلى الخارج.</li></ul>
      <p>الفلتر المعدني للدهون مختلف عن فلتر الكربون للروائح. اتبع تعليمات التنظيف والاستبدال، فليس كل فلتر كربوني قابلاً للغسل. والشكل المسطح أو الهرمي أو المخفي لا يحدد وحده نظام التشغيل.</p>
    </section>
    <aside class="note" aria-label="طلب مراجعة مسار الدكت"><p><strong>قبل إغلاق السقف أو قص وحدة المطبخ:</strong> أرسل صورة المكان ورقم موديل الشفاط ومكان الطرد المقترح لمراجعة نطاق التأسيس والخامات المطلوبة.</p><div class="actions"><a class="btn btn-primary" href="https://wa.me/201101219418">أرسل تفاصيل المطبخ على واتساب</a><a class="btn btn-secondary" href="tel:+201101219418">اتصل لتنسيق المعاينة</a></div></aside>
    <section id="problems"><h2>أخطاء تسبب ضعف الشفط والضوضاء ورجوع الروائح</h2>
      <h3>تضييق الدكت وكثرة الأكواع</h3><p>تقليل مساحة المجرى أو ضغط الخرطوم خلف الدواليب يضيف مقاومة لمسار الطرد. الحل يبدأ بمراجعة القطر والانتقالات والمسار، قبل افتراض أن زيادة قدرة الموتور ستعالج المشكلة.</p>
      <h3>اهتزاز التثبيت ومعالجة الصوت بطريقة غير مناسبة</h3><p>قد ينتقل اهتزاز الجهاز إلى الخشب أو الحائط، وقد ينشأ الصوت من سرعة الهواء داخل ممر ضيق. نراجع مصدر الصوت ونقاط التثبيت أولاً. لا توضع مواد عزل مرتجلة داخل مجرى محمل بالدهون؛ أي عزل أو ملحق صوتي يحتاج توافقاً مع الاستخدام وإمكانية التنظيف.</p>
      <h3>بوابة منع الرجوع والفتحة الخارجية</h3><p>رداد الهواء، أو صمام عدم الرجوع، يساعد في تقليل ارتداد الهواء عند ملاءمته وتركيبه الصحيح، لكنه ليس ضماناً لمنع كل الروائح أو الحشرات. نراجع اتجاهه وحركته ومخرج الطرد؛ والشبك غير المناسب قد يتسخ ويعيق السحب. عند استمرار العطل راجع <a href="/services/maintenance">صيانة الشفاطات وتشخيص ضعف السحب</a>.</p>
    </section>
    <section id="safety"><h2>معايير الأمان قبل الحفر والتوصيل</h2>
      <ul><li>اتباع تعليمات الشفاط وسطح الطهي معاً لتحديد ارتفاع التركيب؛ لا يوجد ارتفاع واحد مناسب لكل الأجهزة.</li><li>فصل التغذية أثناء العمل، وتنفيذ التوصيلات والحماية الكهربائية بواسطة مختص.</li><li>مراجعة أماكن التسليح والكابلات والمواسير قبل الكور دريل؛ لا تُثقب الكمرات أو الأعمدة أو تُقطع أسياخ دون مراجعة إنشائية مختصة.</li><li>مراجعة هواء التعويض وخطر ارتداد غازات الاحتراق عند وجود أجهزة احتراق تعتمد على هواء الغرفة.</li><li>عدم توصيل طرد المطبخ بمدخنة احتراق أو مجرى مشترك دون مراجعة تصميم متخصص.</li></ul>
      <p>هود المطعم ومجرى الدهون لهما متطلبات مختلفة عن الشفاط المنزلي، ولا تستخدم مقاسات هذه الصفحة لتصميم مطبخ تجاري.</p>
    </section>
    <section id="cost"><h2>تكلفة تركيب شفاط مطبخ وما يجب أن يتضمنه العرض</h2>
      <p>لا يوجد سعر واحد يعبر عن تركيب جهاز في فتحة جاهزة وتأسيس مسار جديد فوق سقف معلق. إذا كان طلبك تركيب مدخنة شفاط مطبخ في مكان قائم، جهز صور المسار الحالي قبل زيارة فني تركيب شفاط المطبخ. لتقدير النطاق أرسل:</p>
      <ul><li>المنطقة وحالة المطبخ: تحت التشطيب أم جاهز للاستخدام.</li><li>رقم الموديل وصور موضع التثبيت ومخرج الهواء المتاح.</li><li>المسار التقريبي وارتفاع العمل وأي فتحات أو وحدات قائمة.</li><li>هل المطلوب تركيب الجهاز فقط، أم الدكت والخامات وأعمال الفتح أيضاً؟</li></ul>
      <p>راجع فصل الخامات والأجور والتعديلات وتكلفة الانتقال وموعد التنفيذ والاستثناءات. تُراجع شروط أي ضمان مكتوب إن وُجد ضمن العرض. لا يمكن تأكيد «بدون تكسير» أو «معاينة مجانية» قبل معرفة ظروف الموقع وشروط الخدمة.</p>
      <p>لتجهيز مكانك قبل الزيارة، اقرأ <a href="/blog/how-to-install-kitchen-hood">دليل تجهيز المطبخ لتركيب الشفاط</a>.</p>
    </section>
    <section id="questions"><h2>أسئلة شائعة عن تأسيس وتركيب شفاط المطبخ</h2>{seo.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section class="note"><h2>ابدأ بمراجعة المسار قبل شراء الوصلات</h2><p>أرسل رقم الموديل وصور المطبخ والمنطقة. نراجع إمكانية تنفيذ الخدمة في موقعك ونوضح ما يحتاج معاينة قبل تثبيت نطاق العمل والسعر.</p><div class="actions"><a class="btn btn-primary" href="/contact">اطلب معاينة وعرض سعر</a><a class="btn btn-secondary" href="tel:+201101219418">اتصل: 01101219418</a></div></section>
    <section><h2>مراجع مواصفات التركيب</h2><p>تختلف المواصفات بحسب الموديل. راجع <a href="https://www.bosch-home.co.uk/products/cooking-baking/cooker-hoods/installation-faq">إرشادات Bosch عن تركيب الشفاط والدكت</a> ودليل جهازك قبل التنفيذ؛ ذكر العلامة مرجع فني ولا يعني وكالة أو اعتماداً.</p></section>
  <section><h2>تأسيس المسار ومراجعة المقاسات</h2><p>لأعمال المسار والوصلات راجع <a href="/services/exhaust-ducts">دكت شفاط وتأسيس مجاري الطرد</a>، واقرأ <a href="/blog/exhaust-duct-sizing">مقاس دكت شفاط المطبخ وتأثير الأكواع</a> قبل تجهيز الفتحة.</p></section></article>
