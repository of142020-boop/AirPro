---
import Layout from '../layouts/Layout.astro';
---

<Layout title="خدمات إير برو | تركيب شفاطات مطاعم، هود، وصيانة المداخن" description="استكشف خدمات إير برو: تركيب دكت تكييف، تأسيس شفاطات مطابخ الفلل، تفصيل هود ستانلس ستيل للمطاعم، وغسيل المداخن مع استخراج شهادات الدفاع المدني.">
	<section style="padding: 150px 20px 80px; background: linear-gradient(135deg, var(--background) 0%, rgba(14, 165, 233, 0.05) 100%); text-align: center;">
		<div class="animate-fade-up">
			<span style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 2px;">دليلك الشامل لخدماتنا</span>
			<h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: var(--primary-dark); margin: 15px 0;">
				خدمات التركيب والصيانة المعتمدة
			</h1>
			<p style="color: var(--text-muted); font-size: 1.2rem; max-width: 1200px; margin: 0 auto;">
				نقدم أفضل حلول التهوية الشاملة. سواء كنت تبحث عن تركيب شفاطات للمنازل، أو تركيب مدخنة مطبخ للمطاعم الكبرى، أو حتى تصليح شفاطات مطابخ. معنا ستحصل على أفضل شفاط مطبخ يناسب احتياجاتك.
			</p>
		</div>
	</section>

	<section class="section" style="padding-top: 40px; padding-bottom: 80px;">
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px;">
			
			<!-- Service 1: Home & Villas -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-house"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">القطاع السكني (الشقق والفلل)</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب شفاط مطبخ مخفي، تأسيس دكت قبل السيراميك، عمل فتحات بالكور بدون تكسير، وتأسيس الشفاطات المركزية للقصور.
					</p>
				</div>
				<a href="/services/home-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 2: Commercial & Restaurants -->
			<div class="glass-card reveal reveal-delay-2" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-industry"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">القطاع التجاري (المطاعم والمصانع)</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تصنيع هود ستانلس ستيل، تركيب دكت التكييف، فريش اير، بلاورات سحب عملاقة، ومطابقة اشتراطات الدفاع المدني بالكامل.
					</p>
				</div>
				<a href="/services/restaurants-hood" class="btn btn-primary" style="padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 3: Maintenance & Cleaning -->
			<div class="glass-card reveal reveal-delay-3" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-wrench"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">الصيانة والدعم الفني</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						غسيل مداخن المطاعم كيميائياً، استخراج شهادات نظافة معتمدة، صيانة مواتير الشفاطات وتغيير السيور، ومعالجة ضعف السحب.
					</p>
				</div>
				<a href="/services/maintenance" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 4: Built-in Hoods -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-fire-burner"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط بلت ان</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تأسيس وتركيب شفاطات البلت ان المخفية بأعلى كفاءة، مع الحفاظ على الديكور الداخلي وتجنب ارتداد الروائح.
					</p>
				</div>
				<a href="/services/built-in-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 5: Bathroom Fans -->
			<div class="glass-card reveal reveal-delay-2" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-shower"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">شفاطات حمامات</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب شفاطات الحمامات المركزية والسقفية بدقة لسحب الأبخرة والرطوبة بدون أي إزعاج وصوت صامت تماماً.
					</p>
				</div>
				<a href="/services/bathroom-fans" class="btn btn-primary" style="padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 6: Toshiba Fans -->
			<div class="glass-card reveal reveal-delay-3" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-regular fa-star"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط توشيبا</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						فنيون متخصصون لتركيب وصيانة شفاطات توشيبا بجميع أحجامها، مع قص الزجاج الاحترافي والتأسيس الكهربائي السليم.
					</p>
				</div>
				<a href="/services/toshiba-hoods" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 7: Flat Hood -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-regular fa-square"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط مسطح</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تأسيس وتركيب شفاطات مسطحة (بلت ان وبدون مدخنة) لمطابخ عصرية وأنيقة.
					</p>
				</div>
				<a href="/services/flat-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 8: Pyramid Hood -->
			<div class="glass-card reveal reveal-delay-2" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-caret-up"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">تركيب شفاط هرمي</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب المداخن الهرمية الكلاسيكية بجميع مقاساتها، مع تمديد مواسير التهوية بشكل احترافي.
					</p>
				</div>
				<a href="/services/pyramid-hood" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 9: Central Exhaust -->
			<div class="glass-card reveal reveal-delay-3" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-regular fa-building"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">أنظمة شفاط مركزي</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تصميم وتنفيذ تهوية مركزية للفلل الكبرى والمطاعم لضمان سحب الروائح بدون أصوات مزعجة.
					</p>
				</div>
				<a href="/services/central-exhaust" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

			<!-- Service 10: Industrial Blowers -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between; ">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-fan"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">بلاورات وشفاطات صناعية</h2>
					<p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.8;">
						تركيب بلاور شفط وطرد ضخم لتلبية احتياجات المصانع والمطاعم الكبرى، ومراوح طرد مركزي تتحمل ضغط العمل العالي.
					</p>
				</div>
				<a href="/services/industrial-blowers" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>
			
			<!-- Service 11: AC Ducts -->
			<div class="glass-card reveal" style="padding: 40px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: space-between;">
				<div>
					<div style="width: 80px; height: 80px; background: rgba(249, 115, 22, 0.1); color: var(--primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 20px;">
						<i class="fa-solid fa-wind"></i>
					</div>
					<h2 style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 15px;">دكت التكييف المركزي</h2>
					<p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6; margin-bottom: 25px;">
						تصنيع وتركيب دكت التكييف المركزي والمخفي للفلل والمستشفيات بأفضل صاج مجلفن ومعزول مطابق للمواصفات.
					</p>
				</div>
				<a href="/services/ac-ducts" class="btn" style="background: rgba(249, 115, 22, 0.1); color: var(--primary); padding: 12px 30px; font-weight: 600; text-decoration: none; border-radius: 8px;">التفاصيل والخدمات</a>
			</div>

		</div>
	</section>
</Layout>
